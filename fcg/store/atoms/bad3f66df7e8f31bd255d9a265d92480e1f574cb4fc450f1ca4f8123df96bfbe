# -----------------------------------------------------------------------------
# COMPOUND ARM -- the reason this is feasible in one day
# -----------------------------------------------------------------------------
compound_arm:
  key_fact: >-
    source_13 contains BOTH the CRISPR plates and TARGET2 compound plates,
    imaged in the SAME BATCHES on the same days. Compounds and knockouts are
    directly comparable without cross-site harmonization. This is the single
    thing that makes the project tractable today. Do not discard it in favor
    of a larger compound set.

  plates:
    - {plate: CP-CC9-R1-29, batch: 20220914_Run1, shares_batch_with: CP-CC9-R1-01}
    - {plate: CP-CC9-R2-29, batch: 20221009_Run2, shares_batch_with: CP-CC9-R2-01}
    - {plate: CP-CC9-R3-29, batch: 20221017_Run3, shares_batch_with: CP-CC9-R3-01}
    - {plate: CP-CC9-R5-29, batch: 20221109_Run5, shares_batch_with: CP-CC9-R5-01}
    - {plate: CP-CC9-R6-29, batch: 20221120_Run6, shares_batch_with: null}
    - {plate: CP-CC9-R7-29, batch: 20221120_Run6, shares_batch_with: null}
  plate_type: TARGET2
  distinct_perturbations: 302
  wells: 2304
  dmso_wells_per_plate: {CP-CC9-R1-29: 64, CP-CC9-R2-29: 64, CP-CC9-R3-29: 64, CP-CC9-R5-29: 64, CP-CC9-R6-29: 79, CP-CC9-R7-29: 79}
  dmso_jcp: JCP2022_033924
  verified: true

  annotation_source:
    file: JUMP-Target-2_compound_metadata.tsv
    repo: https://github.com/jump-cellpainting/JUMP-Target
    provides: [broad_sample, InChIKey, pert_iname, pubchem_cid, target_list, smiles, InChI]
    note: >-
      SMILES ship with the metadata. The molecular representation step is
      already solved for this arm. Do not build a structure-fetching layer.

  scale_out_if_time_remains:
    full_set: cpg0016 compound.csv.gz, 116753 compounds
    blocker: spans 10+ sources, requires batch correction
    invariant: >-
      Do NOT begin scale-out before the enrichment gate below has passed
      on the 302-compound set. A larger list that has not passed the gate
      is worth less than a small list that has.

# -----------------------------------------------------------------------------
# DATA CONTRACT
# -----------------------------------------------------------------------------
data:
  bucket_https: https://cellpainting-gallery.s3.amazonaws.com
  dataset: cpg0016-jump
  profile_path_template: "{bucket}/{dataset}/{source}/workspace/profiles/{batch}/{plate}/{plate}.parquet"
  verified_2026_08_13:
    method: HTTP range request bytes=0-3, expect status 206 and magic "PAR1"
    result: >-
      All 13 required plates (7 tier-1 CRISPR + 6 TARGET2 compound) returned
      206 with valid parquet magic bytes. source_4 ORF plate BR00123613 also
      confirmed reachable. Anonymous access, no credentials required.
    all_13_reachable: true
    note: >-
      If a plate 404s at build time, that is a STOP condition. It means the
      path template or the batch name is wrong. Do not guess an alternative.
  access: public, anonymous, no credentials
  level: well-level aggregated profiles ONLY

  forbidden_downloads:
    - raw images
    - single-cell data
    - illumination correction files
    - any object exceeding 1 GB

  metadata_files:
    base: https://raw.githubusercontent.com/jump-cellpainting/datasets/main/metadata/
    files: [crispr.csv.gz, orf.csv.gz, compound.csv.gz, plate.csv.gz, well.csv.gz, perturbation_control.csv]
    note: all gzipped except perturbation_control.csv

# -----------------------------------------------------------------------------
# METHOD -- the axis. Do not redesign this.
# -----------------------------------------------------------------------------
method:
  step_1_normalize:
    rule: per-plate, against that plate's non-targeting wells
    output: robust z-scored feature matrix
  step_2_disease_vector:
    rule: >-
      For each tier-1 gene, mean profile of its knockout wells minus mean
      profile of same-plate non-targeting wells. Average across replicate
      plates. Then average across genes to form CONSENSUS_DISEASE_VECTOR.
  step_3_compound_vectors:
    rule: >-
      For each TARGET2 compound, mean profile minus same-plate DMSO
      (JCP2022_033924). Same batch as the knockout plates where available.
  step_4_rank:
    metric: cosine similarity to CONSENSUS_DISEASE_VECTOR
    ordering: most negative first (opposing the disease direction)
    output: ranked list with score, InChIKey, pert_iname, target_list
  step_5_null:
    rule: >-
      Permutation null over shuffled well labels. Report an empirical
      p-value per compound. A ranked list without a null is not a result.

  forbidden_method_changes:
    - substituting a learned embedding for the raw feature space
    - training any model
    - dropping the permutation null "for time"
    - pooling controls across plates
    - mixing source_13 and source_4 profiles in one distance computation

# -----------------------------------------------------------------------------
# GATES -- each must PASS or be reported as FAILED. Never silently skipped.
# -----------------------------------------------------------------------------
gates:
  gate_1_replicate_reproducibility:
    test: >-
      Knockout signatures for the same gene correlate across the 7
      replicate plates above the median correlation of random well pairs.
    on_fail: STOP. The axis is noise. Report it. Do not proceed to ranking.

  gate_2_consensus_coherence:
    test: >-
      Tier-1 gene vectors (TAZ, CRLS1) are positively correlated with each
      other. Two independent lesions in one pathway should agree.
    on_fail: >-
      Report the disagreement honestly. You may proceed with single-gene
      TAZ only, but the deck must say "single gene, consensus not established."

  gate_3_annotation_enrichment:
    test: >-
      Top-ranked opposing compounds are enriched for mitochondrial /
      oxidative-phosphorylation / membrane annotations in target_list,
      relative to the full 302-compound background. Fisher exact test.
    why: >-
      This is the credibility number. The method is never told what a
      mitochondrion is. If it rediscovers the right neighborhood unaided,
      the list is worth reading. If it does not, the list is worth
      reporting as negative.
    on_fail: >-
      REPORT THE NEGATIVE RESULT. Do not tune parameters until it passes.
      Do not change the gene set until it passes. A disclosed miss is
      publishable; a tuned pass is not.

  gate_4_custody_recompute:
    test: >-
      Every claim in the final artifact recomputes bit-identically from
      its named input bytes. Admit iff recomputes.
    on_fail: reject the claim. Do not annotate it. Do not warn and continue.

  gate_5_tamper_demo:
    test: >-
      Mutate one upstream input byte. The dependent downstream claim
      auto-invalidates and is visibly marked as such without human action.
    required_for_demo: true

# -----------------------------------------------------------------------------
# REQUIRED OUTPUTS -- done means all of these exist
# -----------------------------------------------------------------------------
required_outputs:
  - path: results/ranked_compounds.csv
    must_contain: [rank, cosine_to_disease_axis, empirical_p, InChIKey, pert_iname, target_list]
  - path: results/enrichment_report.json
    must_contain: [fisher_p, odds_ratio, background_n, top_n, verdict]
  - path: results/gates.json
    must_contain: [gate_1, gate_2, gate_3, gate_4, gate_5, each with pass/fail and evidence hash]
  - path: fco/binding.json
    must_contain: [binding_leaf, claim_ceiling, layer_0_atoms with per-file sha256 and byte counts]
  - path: fco/ss31_molecule.json
    must_contain: [source_representation, SMILES, InChIKey, sha256]
    note: SS-31 as a hashed artifact, labeled ANCHOR_NOT_RESULT
  - path: SLIDE_DECK.md
    constraint: 7 slides, every claim carries its gate status
  - path: docs/video_voiceover.txt
    constraint: 90 seconds, contains the required hedge verbatim

# -----------------------------------------------------------------------------
# FORBIDDEN -- non-negotiable
# -----------------------------------------------------------------------------
forbidden:
  scope:
    - starting a new biological hypothesis
    - changing the gene set to one that produces a better-looking result
    - substituting a different disease
    - adding a second disease before tier 1 is complete
  engineering:
    - refactoring working code not required by a failing test
    - redesigning repository architecture
    - changing the FCO schema except a backwards-compatible bug fix
    - adding Neptune, CompuCell3D, HealthOmics, or ClawMax
    - training any model
    - introducing paid APIs or paid compute
    - rewriting documentation for style alone
    - creating speculative follow-up features
  data:
    - downloading raw images or single-cell data
    - committing any parquet or raw dataset to git
    - publishing anything from the frozen manuscript package
    - committing credentials, .env contents, or API keys
  claims:
    - promoting any claim above REPURPOSING_HYPOTHESIS
    - presenting prior custody-layer benchmark numbers as biological results
    - reusing detector metrics (MCC 1.0, FPR 0.0, 0/3000 false admits)
      without the label "custody-layer evidence, prior work, language-model
      substrate, not biology"

# -----------------------------------------------------------------------------
# STOP CONDITIONS -- halt and report, do not self-resolve
# -----------------------------------------------------------------------------
stop_and_report_if:
  - any JCP identifier in this file fails to resolve against live metadata
  - any listed plate is absent from the bucket
  - gate_1 fails
  - a required output cannot be produced without violating a forbidden item
  - you believe a constraint in this file is wrong
  - you are about to write any word from banned_vocabulary
  - elapsed time exceeds 6 hours with no ranked list produced

# -----------------------------------------------------------------------------
# PHASE
# -----------------------------------------------------------------------------
current_phase: PHASE_1_TIER_1_AXIS
required_output_this_phase: results/ranked_compounds.csv from tier-1 genes only
completion_condition: >-
  ranked_compounds.csv exists, gate_1 and gate_3 have recorded verdicts
  (pass OR fail, both acceptable), and every row traces to a hashed input.
next_phase_unlocks_only_when: completion_condition is satisfied

open_risks_declared:
  - cross-source comparison (ORF arm) is not valid without harmonization
  - 302 compounds is a small screening space; absence of hits is weakly informative
  - Cell Painting reports morphology, not mechanism; ceiling is structural, not a limitation to be engineered away
  - TARGET2 compounds are target-annotated, which makes gate_3 possible but also makes the background non-random
