# =============================================================================
# HACKDAY_STATE.yaml
# Execution contract. Binding invariants, not goals.
#
# READ THIS FIRST, AGENT:
#   Every field below is a CONSTRAINT, not a suggestion or an aspiration.
#   You do not have discretion to reinterpret a constraint because you
#   found something more interesting, more elegant, or easier.
#   If reality contradicts this file, you STOP and report the contradiction.
#   You do not resolve it yourself. You do not "adapt the plan."
#
#   Any identifier in this file marked `verified: true` was checked against
#   live JUMP metadata on 2026-08-13. Do not substitute, guess, correct,
#   or "fix" an identifier. If a lookup fails, that is a finding to report,
#   not an error to route around.
# =============================================================================

schema: hackday-execution-contract/v1
generated: "2026-08-13"
project: BioCustody
one_line: >-
  SS-31 proved the mitochondrial membrane is druggable. It is a daily
  injection that treats one disease. We rank existing small molecules for
  which ones reproduce the effect of genetically repairing that membrane,
  and we bind every number to the bytes it came from.

# -----------------------------------------------------------------------------
# CLAIM CEILING -- the single most violable invariant in this file
# -----------------------------------------------------------------------------
claim_ceiling:
  maximum_permitted_claim: REPURPOSING_HYPOTHESIS
  meaning: >-
    A ranked list of small molecules whose morphological signature opposes
    the consensus signature of cardiolipin-pathway gene knockouts.
    That is the entire claim. Nothing above it is authorized.

  explicitly_not_claimed:
    - measured rescue of any disease phenotype
    - efficacy, in any system, in vitro or in vivo
    - binding to cardiolipin or to any named molecular target
    - mechanism of action of any ranked compound
    - equivalence, similarity, or comparability to SS-31 / elamipretide
    - therapeutic relevance to any named patient population

  hard_rule: >-
    PREDICTED COUNTER-PERTURBATION IS NOT MEASURED RESCUE.
    Cell Painting observes morphology. It does not observe mechanism.
    A compound that opposes the disease axis has produced a correlated
    image, and nothing more has been shown.

  banned_vocabulary:
    # If any of these appear in generated code comments, README, slides,
    # voiceover, figure captions, or commit messages -> build is non-compliant.
    - rescues
    - reverses
    - treats
    - cures
    - therapeutic
    - efficacious
    - validated hit
    - lead compound
    - proven
    - demonstrates that
    - cardiolipin binder
    - small-molecule SS-31
    - SS-31 analog
    - SS-31 mimetic
  required_hedge_on_every_result_surface: >-
    "Predicted counter-perturbation. Not measured rescue."

# -----------------------------------------------------------------------------
# SS-31 -- role is FIXED. Do not promote it.
# -----------------------------------------------------------------------------
ss31:
  identity:
    names: [SS-31, elamipretide, MTP-131, Bendavia]
    brand_approved_2025: FORZINITY
    modality: tetrapeptide
    mechanism_literature: binds cardiolipin on the inner mitochondrial membrane
    regulatory_status: >-
      FDA accelerated approval, 2025, Barth syndrome, patients >30 kg.
      First mitochondrial-targeting therapy approved.

  role_in_this_project: ANCHOR_AND_MOTIVATION_ONLY

  invariants:
    - SS-31 is NOT in the JUMP compound library. It is a peptide.
    - SS-31 therefore CANNOT appear as a hit. It cannot be recovered,
      ranked, scored, or validated by this pipeline.
    - Any output that presents SS-31 as an algorithmic result is a
      contract violation and must be deleted, not edited.
    - SS-31 justifies WHY the target is worth pursuing. It is not evidence
      that any ranked compound resembles it.

  permitted_use:
    - narrative framing in deck / voiceover / README
    - "unmet-need argument: peptide = injected daily, not oral, does not
       cross the blood-brain barrier, so neurological mitochondrial disease
       (Leigh, MELAS) is out of its reach"
    - entry into the custody graph as a hashed molecular artifact
      via the BILN/HELM -> pyPept -> RDKit -> SMILES/InChIKey bridge

  forbidden_use:
    - computing similarity between SS-31 and any ranked compound
    - implying the pipeline "found" or "would have found" SS-31
    - using SS-31 as a positive control for the ranking

# -----------------------------------------------------------------------------
# BIOLOGY -- LOCKED. Do not substitute genes.
# -----------------------------------------------------------------------------
biology:
  disease_axis_concept: >-
    Barth syndrome is a membrane-folding disease, not a protein-folding
    disease. TAFAZZIN maintains cardiolipin; cardiolipin holds the shape of
    the cristae; broken cristae underperform. Cell Painting stains
    mitochondria as one of its eight compartments, so the readout channel
    is on-mechanism for both the lesion and for SS-31.

  design_rationale: >-
    We do not use a single gene. A compound opposing one knockout is
    plausibly fitting noise. We define the disease direction as the
    CONSENSUS of independent ways of breaking the same membrane, and rank
    against that consensus. This mirrors SS-31's own logic: it does not
    repair tafazzin, it stabilizes the membrane downstream of the lesion.

  # All IDs verified against jump-cellpainting/datasets @ main, 2026-08-13
  consensus_knockout_set:
    modality: CRISPR
    source: source_13
    all_verified: true

    tier_1_mandatory:
      # Both live on the SAME plate design (CP-CC9-R*-01) across 7 replicates.
      # Cheapest viable axis. If you build nothing else, build this.
      genes:
        - symbol: TAZ
          jcp: JCP2022_806962
          ncbi_gene_id: 6901
          well: E06
          role: cardiolipin remodeling (Barth syndrome causal gene)
          verified: true
        - symbol: CRLS1
          jcp: JCP2022_801511
          ncbi_gene_id: 54675
          well: M04
          role: cardiolipin synthase (makes the lipid)
          verified: true
      plates:
        - {plate: CP-CC9-R1-01, batch: 20220914_Run1}
        - {plate: CP-CC9-R2-01, batch: 20221009_Run2}
        - {plate: CP-CC9-R3-01, batch: 20221017_Run3}
        - {plate: CP-CC9-R5-01, batch: 20221109_Run5}
        - {plate: CP-CC9-R6-01, batch: 20221109_Run5}
        - {plate: CP-CC9-R7-01, batch: 20221109_Run5}
        - {plate: CP-CC9-R8-01, batch: 20221109_Run5}
      note: "CP-CC9-R4-01 does not exist. This is expected. Do not search for it."

    tier_2_optional:
      # Only attempt after tier_1 produces a ranked list end to end.
      genes:
        - symbol: PGS1
          jcp: JCP2022_805090
          ncbi_gene_id: 9489
          role: "cardiolipin precursor synthesis"
          wells_by_plate: {CP-CC9-R1-05: J03, CP-CC9-R1-22: D03, CP-CC9-R2-05: J03, CP-CC9-R2-22: D03, CP-CC9-R3-05: J03, CP-CC9-R3-22: D03, CP-CC9-R4-05: J03, CP-CC9-R4-22: D03, CP-CC9-R5-05: J03, CP-CC9-R5-22: D03}
          verified: true
        - symbol: PTPMT1
          jcp: JCP2022_805673
          ncbi_gene_id: 114971
          role: "phosphatase required for cardiolipin biosynthesis"
          well: H14
          plates: [CP-CC9-R1-16, CP-CC9-R2-16, CP-CC9-R3-16, CP-CC9-R4-16, CP-CC9-R5-16]
          verified: true
        - symbol: HADHA
          jcp: JCP2022_803009
          ncbi_gene_id: 3030
          role: "alternate cardiolipin remodeling route"
          well: D13
          plates: [CP-CC9-R1-11, CP-CC9-R2-11, CP-CC9-R3-11, CP-CC9-R4-11, CP-CC9-R5-11]
          verified: true
        - symbol: PHB
          jcp: JCP2022_805091
          ncbi_gene_id: 5245
          role: "prohibitin scaffold, cardiolipin-binding"
          well: G22
          plates: [CP-CC9-R1-24, CP-CC9-R2-24, CP-CC9-R3-24, CP-CC9-R4-24, CP-CC9-R5-24]
          verified: true
        - symbol: PHB2
