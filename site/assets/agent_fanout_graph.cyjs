          "fco_id": "sha256:ad210e40a5b930c1ab8f7629a1d76802b43e635364c167ed493a0e2488be943a",
          "id": "elvis_integrator",
          "kind": "agent_fco",
          "label": "elvis_integrator\\nad210e40a5b9",
          "proposed_update": "Integrate a visual indicator highlighting data provenance and validation status within the Disease Search dashboard component.",
          "role": "Disease search integrator",
          "summary": "Proposed enhancement involves adding provenance visuals to improve data traceability in disease dashboards."
        }
      },
      {
        "data": {
          "fco_id": "sha256:79597008511b84205cd67266b364df777b31d0c96ac3da98b88e92deeb2dbecc",
          "id": "environment_packager",
          "kind": "agent_fco",
          "label": "environment_packager\\n79597008511b",
          "proposed_update": "Add a requirements.txt and package.json files documenting all dependencies with specific versions.",
          "role": "Environment packager",
          "summary": "Include a comprehensive list of required Python and npm packages with version specifications for local reproduction."
        }
      },
      {
        "data": {
          "fco_id": "sha256:b20e6520d32edefd96f4895b7a305a7c3253c9adabc9f974abc3b45c48714df4",
          "id": "fco_mapper",
          "kind": "agent_fco",
          "label": "fco_mapper\\nb20e6520d32e",
          "proposed_update": "Create an FCO for the fan-out receipt that includes links to individual content updates, with hash references for traceability.",
          "role": "FCO graph mapper",
          "summary": "This maps fan-out receipt content as FCOs linking specific content updates in the provenance model."
        }
      },
      {
        "data": {
          "fco_id": "sha256:f8bc77cb9f40153559c71072076f164cc157845294b91c113090ccc00e0941ea",
          "id": "figure_auditor",
          "kind": "agent_fco",
          "label": "figure_auditor\\nf8bc77cb9f40",
          "proposed_update": "Add an annotations layer highlighting key experimental controls and data points that support the restoration claim, along with a disclaimer on data validation limits.",
          "role": "Scientific figure auditor",
          "summary": "The restoration figure appears consistent with the presented evidence but should include caveats about data verification and validation boundaries."
        }
      },
      {
