          "id": "navigator",
          "kind": "agent_fco",
          "label": "navigator\\nfefccc50ff74",
          "proposed_update": "Add an interactive overlay in the dashboard that highlights the custody receipt's link from the scientific result with a tooltip explaining the transfer process.",
          "role": "Evidence navigator",
          "summary": "Guide viewers from the scientific result through the dashboard to the custody receipt, emphasizing the evidence flow and secure linking mechanisms."
