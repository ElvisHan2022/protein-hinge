        "data": {
          "fco_id": "sha256:f1535011dce34aa87eec459f4e5003d72f608d31fa42d287b3b863ec2438e412",
          "id": "elvis_integrator",
          "kind": "agent_fco",
          "label": "elvis_integrator\\nf1535011dce3",
          "proposed_update": "Integrate a step in the demo to visualize the data lineage and provenance of the repurposed drug candidates within the dashboard.",
          "role": "Elvis component integrator",
          "summary": "The demo will include a traceability feature for drug candidates to enhance transparency."
        }
      },
      {
        "data": {
          "fco_id": "sha256:acff71954fc49bbfbffc4baf745686d7ed0a8721340aba5b68fca9af593ee88c",
          "id": "environment_packager",
          "kind": "agent_fco",
          "label": "environment_packager\\nacff71954fc4",
          "proposed_update": "Add a requirements.txt and package.json file detailing necessary Python and npm packages for local demo reproduction.",
          "role": "Environment packager",
          "summary": "The demo requires specific Python and npm packages documented in requirements.txt and package.json for reproducibility."
        }
      },
      {
        "data": {
          "fco_id": "sha256:cd6c929527f26b73e003b89122ba318775dce0433556a04c7cc696494eea17cf",
          "id": "fco_mapper",
          "kind": "agent_fco",
          "label": "fco_mapper\\ncd6c929527f2",
          "proposed_update": "Create an FCO node capturing the fan-out event, linking to individual content updates such as the processed cell-perturbation figure, hash-pinned ledger entries, and UI state changes.",
          "role": "FCO graph mapper",
          "summary": "This agent maps the fan-out as an FCO node linked to its content updates, enhancing provenance traceability."
        }
      },
      {
        "data": {
          "fco_id": "sha256:7e7c08bbaa85700113a5e376faa9c130f342fad7654d1806d8dcd86d6a7b62a9",
          "id": "figure_auditor",
          "kind": "agent_fco",
          "label": "figure_auditor\\n7e7c08bbaa85",
          "proposed_update": "Add detailed metadata and data provenance info to the figure hover or caption to clarify data sources and processing steps.",
          "role": "Scientific figure auditor",
          "summary": "The figure's honesty about data and claims can be improved by transparent metadata and provenance, but direct verification remains limited."
        }
      },
      {
        "data": {
          "fco_id": "sha256:8349200fffae6c520ed525ac78b6210fd43fef7260329833e5487e5c7d92387c",
          "id": "integration",
          "kind": "integration_fco",
          "label": "integration\\n8349200fffae",
          "role": "Fan-out integration object",
          "summary": "Links model, agent objects, dashboard, database projection, and claim ceiling."
        }
      },
