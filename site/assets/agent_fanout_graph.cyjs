      },
      {
        "data": {
          "fco_id": "sha256:840b5a529e9efa7620dd25e6625e2fb2980c22685e2dbf382c0c749a8f8ec6ee",
          "id": "navigator",
          "kind": "agent_fco",
          "label": "navigator\\n840b5a529e9e",
          "proposed_update": "Add an interactive tooltip on the dashboard figure that, when clicked, displays the linked FCO receipt details with a 'View Custody Record' button.",
          "role": "Evidence navigator",
          "summary": "Guide users from viewing the scientific result to accessing the hash-pinned custody receipt via integrated dashboard links and interactive elements."
        }
      }
